{
  "id": "project",
  "order": 2,
  "name": {
    "one": "table.project.name.one",
    "many": "table.project.name.many"
  },
  "store": "data/projects.jsonl",
  "type": "project",
  "primary": "name",
  "columns": [
    "status",
    "name"
  ],
  "desc": "the direction; macro or micro by the parent tree — the task is the movement",
  "fields": {
    "id": {
      "label": "table.project.field.id",
      "filterable": true,
      "searchable": true
    },
    "name": {
      "label": "table.project.field.name",
      "filterable": true,
      "searchable": true
    },
    "parent": {
      "label": "table.project.field.parent",
      "filterable": true,
      "searchable": true,
      "ref": [
        "project"
      ],
      "default": null
    },
    "status": {
      "label": "table.project.field.status",
      "filterable": true,
      "searchable": true,
      "enum": {
        "idea": "table.project.field.status.idea",
        "active": "table.project.field.status.active",
        "paused": "table.project.field.status.paused",
        "done": "table.project.field.status.done",
        "cancelled": "table.project.field.status.cancelled"
      },
      "show": [
        "idea",
        "active",
        "paused"
      ],
      "default": "idea"
    },
    "desc": {
      "label": "table.project.field.desc",
      "type": "markdown",
      "searchable": true
    },
    "since": {
      "label": "table.project.field.since",
      "type": "day",
      "filterable": true,
      "searchable": true,
      "default": "today"
    }
  },
  "lifecycle": {
    "cancel": {
      "status": "cancelled",
      "reason": {
        "into": "desc",
        "text": "table.closed.reason"
      },
      "reason_required": true
    }
  }
}

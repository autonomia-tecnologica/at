      "searchable": true
    },
    "what": {
      "label": "table.job.field.what",
      "filterable": true,
      "searchable": true,
      "required": true
    },
    "table": {
      "label": "table.job.field.table",
      "filterable": true,
      "searchable": true,
      "required": true
    },
    "arguments": {
      "label": "table.job.field.arguments",
      "type": "list"
    },
    "actor": {
      "label": "table.job.field.actor",
      "filterable": true
    },
    "when": {
      "label": "table.job.field.when",
      "type": "instant",
      "filterable": true,
      "required": true
    },
    "status": {
      "label": "table.job.field.status",
      "filterable": true,
      "searchable": true,
      "required": true,
      "default": "waiting",
      "enum": {
        "waiting": "table.job.field.status.waiting",
        "approved": "table.job.field.status.approved",
        "refused": "table.job.field.status.refused",
        "done": "table.job.field.status.done",
        "scheduled": "table.job.field.status.scheduled"
      }
    }
  }
}

  "columns": [
    "status",
    "what",
    "actor",
    "when"
  ],
  "desc": "the demand that could not run, and the act the clock drives: what it performs, the arguments it needs, the actor that owns it, the instant it is about and the state of its life — waiting, approved, refused, done or scheduled",
  "fields": {
    "id": {
      "label": "table.field.id",
